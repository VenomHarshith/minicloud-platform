# Copy to deploy/.env. Never commit the real file.
MINICLOUD_DB_PASSWORD=replace-with-a-long-random-value
MINICLOUD_CLUSTER_TOKEN=replace-with-a-second-long-random-value
MINICLOUD_API_TOKEN=replace-with-a-third-long-random-value

# Docker Desktop on macOS/Linux exposes this socket to containers by default.
MINICLOUD_DOCKER_SOCKET=/var/run/docker.sock
MINICLOUD_DOCKER_ENDPOINT=unix:///var/run/docker.sock
MINICLOUD_ARCH=arm64

# Docker Desktop users should follow docs/WINDOWS.md or RUN_INSTRUCTIONS.md and add
# deploy/compose.desktop.yaml. Native Windows workers may instead use the
# supported npipe:////./pipe/docker_engine endpoint. Never expose port 2375.
